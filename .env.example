# URLs de microservicios (local)
VITE_URL_MS_SECURITY=http://localhost:8080
VITE_URL_MS_BUSSINES=http://localhost:3000
VITE_URL_MS_MESSAGES=http://localhost:3001
VITE_URL_MS_AI=http://localhost:8001
# ms-ai (PQRS abierto, sin JWT). Preferido para /api/pqrs
VITE_MS_AI_URL=http://127.0.0.1:8001

# Opcional: override WS de business (por defecto usa VITE_URL_MS_BUSSINES)
# VITE_URL_MS_BUSSINES_WS=http://localhost:3000

VITE_RECAPTCHA_SITE_KEY=Propia
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_SCOPE=openid,profile,email

# ePayco Smart Checkout: false en producción
VITE_EPAYCO_TEST=true

# Opcional: motor de rutas para polylines en mapa (OSRM).
# Por defecto usa el demo público. En producción preferir instancia propia.
# VITE_OSRM_URL=https://router.project-osrm.org

# ---------------------------------------------------------------------------
# CORS / origen del frontend (configurar en los backends, NO en Vite)
# El FE corre en http://localhost:5173 (Vite). Sin este origen en los MS,
# REST y WebSocket fallan en el navegador.
#
# ms-business  → FRONTEND_URL=http://localhost:5173
# ms-security  → CORS_ALLOWED_ORIGINS=http://localhost:5173,...
# ms-messages  → CORS_ALLOWED_ORIGINS=http://localhost:5173,...
# ms-ai        → CORS_ALLOWED_ORIGINS=http://localhost:5173,...
#
# Socket.IO:
#   chat      → path /messages/ws  namespace /messages
#   dashboard → path /dashboard/realtime/ws  namespace /dashboard/realtime
# ---------------------------------------------------------------------------
