openapi: 3.1.0
info:
  title: "MS AI - Scheduler, PQRS & Weather"
  description: "Microservicio de agendamiento de citas, PQRS automatizado y alertas de clima"
  version: 1.0.0
paths:
  "/":
    get:
      summary: Root
      operationId: root__get
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
  "/api/appointments/availability":
    get:
      tags[1]: Appointments
      summary: Get Availability
      description: Retorna los bloques de 30 min disponibles para los próximos `days` días hábiles.
      operationId: get_availability_api_appointments_availability_get
      parameters[2]:
        - name: days
          in: query
          required: false
          schema:
            type: integer
            maximum: 60
            minimum: 1
            default: 10
            title: Days
        - name: start_date
          in: query
          required: false
          schema:
            anyOf[2]:
              - type: string
                format: date-time
              - type: "null"
            title: Start Date
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/AvailabilityResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/appointments":
    get:
      tags[1]: Appointments
      summary: List Appointments
      operationId: list_appointments_api_appointments_get
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                items:
                  "$ref": #/components/schemas/AppointmentResponse
                type: array
                title: Response List Appointments Api Appointments Get
    post:
      tags[1]: Appointments
      summary: Create Appointment
      operationId: create_appointment_api_appointments_post
      requestBody:
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/CreateAppointmentRequest
        required: true
      responses:
        "201":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/AppointmentResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/appointments/user/{user_id}":
    get:
      tags[1]: Appointments
      summary: Get Appointments By User
      operationId: get_appointments_by_user_api_appointments_user__user_id__get
      parameters[3]:
        - name: user_id
          in: path
          required: true
          schema:
            type: string
            title: User Id
        - name: start_date
          in: query
          required: false
          schema:
            anyOf[2]:
              - type: string
                format: date-time
              - type: "null"
            title: Start Date
        - name: end_date
          in: query
          required: false
          schema:
            anyOf[2]:
              - type: string
                format: date-time
              - type: "null"
            title: End Date
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                type: array
                items:
                  "$ref": #/components/schemas/AppointmentResponse
                title: Response Get Appointments By User Api Appointments User  User Id  Get
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/appointments/{id}":
    get:
      tags[1]: Appointments
      summary: Get Appointment
      operationId: get_appointment_api_appointments__id__get
      parameters[1]:
        - name: id
          in: path
          required: true
          schema:
            type: string
            title: Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/AppointmentResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    put:
      tags[1]: Appointments
      summary: Update Appointment
      operationId: update_appointment_api_appointments__id__put
      parameters[1]:
        - name: id
          in: path
          required: true
          schema:
            type: string
            title: Id
      requestBody:
        required: true
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/UpdateAppointmentRequest
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/AppointmentResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    delete:
      tags[1]: Appointments
      summary: Delete Appointment
      operationId: delete_appointment_api_appointments__id__delete
      parameters[1]:
        - name: id
          in: path
          required: true
          schema:
            type: string
            title: Id
      responses:
        "204":
          description: Successful Response
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/pqrs":
    post:
      tags[1]: PQRS
      summary: Create Pqrs
      operationId: create_pqrs_api_pqrs_post
      requestBody:
        required: true
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/CreatePqrsRequest
      responses:
        "201":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    get:
      tags[1]: PQRS
      summary: List Pqrs
      operationId: list_pqrs_api_pqrs_get
      parameters[3]:
        - name: status
          in: query
          required: false
          schema:
            anyOf[2]:
              - "$ref": #/components/schemas/PqrsStatus
              - type: "null"
            title: Status
        - name: category
          in: query
          required: false
          schema:
            anyOf[2]:
              - "$ref": #/components/schemas/PqrsCategory
              - type: "null"
            title: Category
        - name: user_email
          in: query
          required: false
          schema:
            anyOf[2]{type}:
              string
              "null"
            title: User Email
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                type: array
                items:
                  "$ref": #/components/schemas/PqrsResponse
                title: Response List Pqrs Api Pqrs Get
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/pqrs/ticket/{ticket_number}":
    get:
      tags[1]: PQRS
      summary: Get Pqrs By Ticket
      operationId: get_pqrs_by_ticket_api_pqrs_ticket__ticket_number__get
      parameters[1]:
        - name: ticket_number
          in: path
          required: true
          schema:
            type: string
            title: Ticket Number
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/pqrs/{pqrs_id}":
    get:
      tags[1]: PQRS
      summary: Get Pqrs
      operationId: get_pqrs_api_pqrs__pqrs_id__get
      parameters[1]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    put:
      tags[1]: PQRS
      summary: Update Pqrs
      operationId: update_pqrs_api_pqrs__pqrs_id__put
      parameters[1]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
      requestBody:
        required: true
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/UpdatePqrsRequest
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    delete:
      tags[1]: PQRS
      summary: Delete Pqrs
      operationId: delete_pqrs_api_pqrs__pqrs_id__delete
      parameters[1]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
      responses:
        "204":
          description: Successful Response
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/pqrs/{pqrs_id}/updates":
    post:
      tags[1]: PQRS Updates
      summary: Create Pqrs Update
      operationId: create_pqrs_update_api_pqrs__pqrs_id__updates_post
      parameters[1]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
      requestBody:
        required: true
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/CreatePqrsUpdateRequest
      responses:
        "201":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsUpdateResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    get:
      tags[1]: PQRS Updates
      summary: List Pqrs Updates
      operationId: list_pqrs_updates_api_pqrs__pqrs_id__updates_get
      parameters[1]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                type: array
                items:
                  "$ref": #/components/schemas/PqrsUpdateResponse
                title: Response List Pqrs Updates Api Pqrs  Pqrs Id  Updates Get
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/pqrs/{pqrs_id}/updates/{update_id}":
    get:
      tags[1]: PQRS Updates
      summary: Get Pqrs Update
      operationId: get_pqrs_update_api_pqrs__pqrs_id__updates__update_id__get
      parameters[2]:
        - name: pqrs_id
          in: path
          required: true
          schema:
            type: string
            title: Pqrs Id
        - name: update_id
          in: path
          required: true
          schema:
            type: string
            title: Update Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/PqrsUpdateResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/weather/alerts":
    post:
      tags[1]: Weather Alerts
      summary: Create Weather Alert
      description: Crea una alerta de clima para un horario de viaje.
      operationId: create_weather_alert_api_weather_alerts_post
      requestBody:
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/CreateWeatherAlertRequest
        required: true
      responses:
        "201":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/WeatherAlertResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/weather/alerts/user/{user_id}":
    get:
      tags[1]: Weather Alerts
      summary: List Weather Alerts By User
      description: Lista todas las alertas de clima de un usuario.
      operationId: list_weather_alerts_by_user_api_weather_alerts_user__user_id__get
      parameters[1]:
        - name: user_id
          in: path
          required: true
          schema:
            type: string
            title: User Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                type: array
                items:
                  "$ref": #/components/schemas/WeatherAlertResponse
                title: Response List Weather Alerts By User Api Weather Alerts User  User Id  Get
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/weather/alerts/{alert_id}":
    get:
      tags[1]: Weather Alerts
      summary: Get Weather Alert
      description: Consulta una alerta de clima por su id.
      operationId: get_weather_alert_api_weather_alerts__alert_id__get
      parameters[1]:
        - name: alert_id
          in: path
          required: true
          schema:
            type: string
            title: Alert Id
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/WeatherAlertResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    put:
      tags[1]: Weather Alerts
      summary: Update Weather Alert
      description: Actualiza una alerta de clima por su id.
      operationId: update_weather_alert_api_weather_alerts__alert_id__put
      parameters[1]:
        - name: alert_id
          in: path
          required: true
          schema:
            type: string
            title: Alert Id
      requestBody:
        required: true
        content:
          "application/json":
            schema:
              "$ref": #/components/schemas/UpdateWeatherAlertRequest
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/WeatherAlertResponse
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
    delete:
      tags[1]: Weather Alerts
      summary: Deactivate Weather Alert
      description: Desactiva una alerta de clima por su id.
      operationId: deactivate_weather_alert_api_weather_alerts__alert_id__delete
      parameters[1]:
        - name: alert_id
          in: path
          required: true
          schema:
            type: string
            title: Alert Id
      responses:
        "204":
          description: Successful Response
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
  "/api/weather/forecast/available-hours":
    get:
      tags[1]: Weather Forecast
      summary: List Available Forecast Hours
      description: Lista los bloques horarios futuros que devuelve OpenWeatherMap para unas coordenadas.
      operationId: list_available_forecast_hours_api_weather_forecast_available_hours_get
      parameters[2]:
        - name: lat
          in: query
          required: true
          schema:
            type: number
            description: Latitud de la ciudad
            title: Lat
          description: Latitud de la ciudad
        - name: lon
          in: query
          required: true
          schema:
            type: number
            description: Longitud de la ciudad
            title: Lon
          description: Longitud de la ciudad
      responses:
        "200":
          description: Successful Response
          content:
            "application/json":
              schema:
        "422":
          description: Validation Error
          content:
            "application/json":
              schema:
                "$ref": #/components/schemas/HTTPValidationError
components:
  schemas:
    AppointmentReason:
      type: string
      enum[4]: credit_card,complaint,refund,other
      title: AppointmentReason
    AppointmentResponse:
      properties:
        id:
          type: string
          title: Id
        calendar_event_id:
          anyOf[2]{type}:
            string
            "null"
          title: Calendar Event Id
        type:
          "$ref": #/components/schemas/AppointmentType
        reason:
          "$ref": #/components/schemas/AppointmentReason
        date_time:
          type: string
          format: date-time
          title: Date Time
        description:
          type: string
          title: Description
        location:
          type: string
          title: Location
        user_id:
          type: string
          title: User Id
        user_email:
          type: string
          title: User Email
        created_at:
          type: string
          format: date-time
          title: Created At
      type: object
      required[10]: id,calendar_event_id,type,reason,date_time,description,location,user_id,user_email,created_at
      title: AppointmentResponse
    AppointmentType:
      type: string
      enum[2]: virtual,in_person
      title: AppointmentType
    AvailabilityResponse:
      properties:
        slots:
          items:
            "$ref": #/components/schemas/SlotResponse
          type: array
          title: Slots
      type: object
      required[1]: slots
      title: AvailabilityResponse
    CreateAppointmentRequest:
      properties:
        type:
          "$ref": #/components/schemas/AppointmentType
        reason:
          "$ref": #/components/schemas/AppointmentReason
        date_time:
          type: string
          format: date-time
          title: Date Time
        description:
          type: string
          maxLength: 300
          title: Description
          default: ""
        user_id:
          type: string
          title: User Id
        user_email:
          type: string
          title: User Email
      type: object
      required[5]: type,reason,date_time,user_id,user_email
      title: CreateAppointmentRequest
    CreatePqrsImageRequest:
      properties:
        filename:
          type: string
          maxLength: 255
          minLength: 1
          title: Filename
        mime_type:
          type: string
          maxLength: 100
          minLength: 1
          title: Mime Type
        content_base64:
          type: string
          minLength: 1
          title: Content Base64
      type: object
      required[3]: filename,mime_type,content_base64
      title: CreatePqrsImageRequest
    CreatePqrsRequest:
      properties:
        type:
          "$ref": #/components/schemas/PqrsType
        category:
          "$ref": #/components/schemas/PqrsCategory
        description:
          type: string
          maxLength: 500
          title: Description
          default: ""
        user_id:
          type: string
          title: User Id
        user_email:
          type: string
          title: User Email
        images:
          items:
            "$ref": #/components/schemas/CreatePqrsImageRequest
          type: array
          maxItems: 3
          title: Images
      type: object
      required[4]: type,category,user_id,user_email
      title: CreatePqrsRequest
    CreatePqrsUpdateRequest:
      properties:
        status_to:
          "$ref": #/components/schemas/PqrsStatus
        description:
          type: string
          maxLength: 1000
          title: Description
          default: ""
        agent_response:
          type: string
          maxLength: 2000
          title: Agent Response
          default: ""
        action:
          type: string
          maxLength: 100
          title: Action
          default: status_change
      type: object
      required[1]: status_to
      title: CreatePqrsUpdateRequest
    CreateWeatherAlertRequest:
      properties:
        user_id:
          type: string
          minLength: 1
          title: User Id
        user_email:
          type: string
          minLength: 3
          title: User Email
        travel_hour:
          type: integer
          maximum: 23
          minimum: 0
          title: Travel Hour
          description: Horario habitual de viaje (0-23)
        city_name:
          type: string
          minLength: 2
          title: City Name
          description: "Ciudad para el pronóstico, ej. Manizales,CO"
        preferred_channel:
          "$ref": #/components/schemas/NotificationChannel
          description: "Canal preferido: email, whatsapp o push"
          default: email
      type: object
      required[4]: user_id,user_email,travel_hour,city_name
      title: CreateWeatherAlertRequest
    HTTPValidationError:
      properties:
        detail:
          items:
            "$ref": #/components/schemas/ValidationError
          type: array
          title: Detail
      type: object
      title: HTTPValidationError
    NotificationChannel:
      type: string
      enum[3]: email,whatsapp,push
      title: NotificationChannel
    PqrsCategory:
      type: string
      enum[5]: driver,bus,route,card,other
      title: PqrsCategory
    PqrsImageResponse:
      properties:
        id:
          type: string
          title: Id
        pqrs_id:
          type: string
          title: Pqrs Id
        image_url:
          type: string
          title: Image Url
        original_name:
          type: string
          title: Original Name
        mime_type:
          type: string
          title: Mime Type
        size:
          type: integer
          title: Size
      type: object
      required[6]: id,pqrs_id,image_url,original_name,mime_type,size
      title: PqrsImageResponse
    PqrsResponse:
      properties:
        id:
          type: string
          title: Id
        ticket_number:
          type: string
          title: Ticket Number
        type:
          "$ref": #/components/schemas/PqrsType
        category:
          "$ref": #/components/schemas/PqrsCategory
        status:
          "$ref": #/components/schemas/PqrsStatus
        description:
          type: string
          title: Description
        user_id:
          type: string
          title: User Id
        user_email:
          type: string
          title: User Email
        estimated_response_at:
          anyOf[2]:
            - type: string
              format: date-time
            - type: "null"
          title: Estimated Response At
        resolved_at:
          anyOf[2]:
            - type: string
              format: date-time
            - type: "null"
          title: Resolved At
        sla_alert_sent:
          type: boolean
          title: Sla Alert Sent
        created_at:
          type: string
          format: date-time
          title: Created At
        updated_at:
          type: string
          format: date-time
          title: Updated At
        images:
          items:
            "$ref": #/components/schemas/PqrsImageResponse
          type: array
          title: Images
        updates:
          items:
            "$ref": #/components/schemas/PqrsUpdateResponse
          type: array
          title: Updates
      type: object
      required[11]: id,ticket_number,type,category,status,description,user_id,user_email,sla_alert_sent,created_at,updated_at
      title: PqrsResponse
    PqrsStatus:
      type: string
      enum[4]: received,in_review,in_progress,resolved
      title: PqrsStatus
    PqrsType:
      type: string
      enum[4]: petition,complaint,claim,suggestion
      title: PqrsType
    PqrsUpdateResponse:
      properties:
        id:
          type: string
          title: Id
        pqrs_id:
          type: string
          title: Pqrs Id
        status_from:
          anyOf[2]:
            - "$ref": #/components/schemas/PqrsStatus
            - type: "null"
        status_to:
          anyOf[2]:
            - "$ref": #/components/schemas/PqrsStatus
            - type: "null"
        action:
          type: string
          title: Action
        description:
          type: string
          title: Description
        agent_response:
          type: string
          title: Agent Response
        created_at:
          type: string
          format: date-time
          title: Created At
      type: object
      required[6]: id,pqrs_id,action,description,agent_response,created_at
      title: PqrsUpdateResponse
    SlotResponse:
      properties:
        start:
          type: string
          format: date-time
          title: Start
        end:
          type: string
          format: date-time
          title: End
      type: object
      required[2]: start,end
      title: SlotResponse
    UpdateAppointmentRequest:
      properties:
        type:
          anyOf[2]:
            - "$ref": #/components/schemas/AppointmentType
            - type: "null"
        reason:
          anyOf[2]:
            - "$ref": #/components/schemas/AppointmentReason
            - type: "null"
        date_time:
          anyOf[2]:
            - type: string
              format: date-time
            - type: "null"
          title: Date Time
        description:
          anyOf[2]:
            - type: string
              maxLength: 300
            - type: "null"
          title: Description
      type: object
      title: UpdateAppointmentRequest
    UpdatePqrsRequest:
      properties:
        type:
          anyOf[2]:
            - "$ref": #/components/schemas/PqrsType
            - type: "null"
        category:
          anyOf[2]:
            - "$ref": #/components/schemas/PqrsCategory
            - type: "null"
        description:
          anyOf[2]:
            - type: string
              maxLength: 500
            - type: "null"
          title: Description
        user_email:
          anyOf[2]{type}:
            string
            "null"
          title: User Email
      type: object
      title: UpdatePqrsRequest
    UpdateWeatherAlertRequest:
      properties:
        user_email:
          type: string
          minLength: 3
          title: User Email
        travel_hour:
          type: integer
          maximum: 23
          minimum: 0
          title: Travel Hour
          description: Horario habitual de viaje (0-23)
        city_name:
          type: string
          minLength: 2
          title: City Name
          description: "Ciudad para el pronóstico, ej. Manizales,CO"
        preferred_channel:
          "$ref": #/components/schemas/NotificationChannel
          description: "Canal preferido: email, whatsapp o push"
          default: email
      type: object
      required[3]: user_email,travel_hour,city_name
      title: UpdateWeatherAlertRequest
    ValidationError:
      properties:
        loc:
          items:
            anyOf[2]{type}:
              string
              integer
          type: array
          title: Location
        msg:
          type: string
          title: Message
        type:
          type: string
          title: Error Type
        input:
          title: Input
        ctx:
          type: object
          title: Context
      type: object
      required[3]: loc,msg,type
      title: ValidationError
    WeatherAlertResponse:
      properties:
        id:
          type: string
          title: Id
        user_id:
          type: string
          title: User Id
        user_email:
          type: string
          title: User Email
        travel_hour:
          type: integer
          title: Travel Hour
        city_name:
          type: string
          title: City Name
        city_lat:
          type: number
          title: City Lat
        city_lon:
          type: number
          title: City Lon
        preferred_channel:
          "$ref": #/components/schemas/NotificationChannel
        is_active:
          type: boolean
          title: Is Active
        last_alert_sent_at:
          anyOf[2]:
            - type: string
              format: date-time
            - type: "null"
          title: Last Alert Sent At
        created_at:
          type: string
          format: date-time
          title: Created At
        updated_at:
          type: string
          format: date-time
          title: Updated At
      type: object
      required[12]: id,user_id,user_email,travel_hour,city_name,city_lat,city_lon,preferred_channel,is_active,last_alert_sent_at,created_at,updated_at
      title: WeatherAlertResponse