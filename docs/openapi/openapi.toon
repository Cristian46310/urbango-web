openapi: 3.1.0
info:
  title: "Micro Servicio de Seguridad"
  description: "API para la gestion de autenticación y autorización utilizando JWT"
  contact:
    name: "Los Tres Mosqueteros"
    url: "https://github.com/JuManoel/dev-backend-uc.git"
    email: cristian.grisales46310@ucaldas.edu.co
  license:
    name: MIT
    url: "https://opensource.org/licenses/MIT"
  version: 1.0.0
servers[1]{url,description}:
  "http://localhost:8080","Generated server url"
security[1]{bearer-jwt}:
  
paths:
  /api/roles/{id}:
    get:
      tags[1]: role-controller
      operationId: findById
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetRoleDTO
    put:
      tags[1]: role-controller
      operationId: update
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostRoleDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetRoleDTO
    delete:
      tags[1]: role-controller
      operationId: delete
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
  /api/public/users/{id}:
    get:
      tags[1]: user-controller
      operationId: getById
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetUserDetailDTO
    put:
      tags[1]: user-controller
      operationId: update_1
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostUserDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetUserDTO
    delete:
      tags[1]: user-controller
      operationId: delete_1
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
  /api/profiles/{id}:
    get:
      tags[1]: profile-controller
      operationId: findById_1
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetProfileDTO
    put:
      tags[1]: profile-controller
      operationId: update_2
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostProfileDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetProfileDTO
    delete:
      tags[1]: profile-controller
      operationId: delete_2
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
  /api/permissions/{id}:
    get:
      tags[1]: permission-controller
      operationId: findById_2
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetPermissionDTO
    put:
      tags[1]: permission-controller
      operationId: update_3
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostPermissionDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetPermissionDTO
    delete:
      tags[1]: permission-controller
      operationId: delete_3
      parameters[1]{name,in,required,schema}:
        id,path,true,[object Object]
      responses:
        200:
          description: OK
  /api/roles:
    get:
      tags[1]: role-controller
      operationId: find
      parameters[1]{name,in,required,schema}:
        pageable,query,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/PageGetRoleDTO
    post:
      tags[1]: role-controller
      operationId: create
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostRoleDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetRoleDTO
  /api/role-permission/role/{roleId}/permission/{permissionId}:
    post:
      tags[1]: role-permission-controller
      operationId: addRolePermission
      parameters[2]{name,in,required,schema}:
        roleId,path,true,[object Object]
        permissionId,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/ResponseMessage
  /api/public/users:
    get:
      tags[1]: user-controller
      operationId: getAllUsers
      parameters[1]{name,in,required,schema}:
        pageable,query,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/PageGetUserDTO
    post:
      tags[1]: user-controller
      operationId: createUser
      requestBody:
        content:
          application/json:
            schema:
              $ref: #/components/schemas/PostUserDTO
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/GetUserDTO
  /api/public/users/{id}/profile/{profileID}:
    post:
      tags[1]: user-controller
      operationId: addProfile
      parameters[2]{name,in,required,schema}:
        id,path,true,[object Object]
        profileID,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/ResponseMessage
    delete:
      tags[1]: user-controller
      operationId: removeProfile
      parameters[2]{name,in,required,schema}:
        id,path,true,[object Object]
        profileID,path,true,[object Object]
      responses:
        200:
          description: OK
  /api/public/user-role/user/{userId}/role/{roleId}:
    post:
      tags[1]: user-role-controller
      operationId: addUserRole
      parameters[2]{name,in,required,schema}:
        userId,path,true,[object Object]
        roleId,path,true,[object Object]
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/ResponseMessage
  /api/public/user-role/assign-multiple:
    post:
      tags[1]: user-role-controller
      operationId: assignMultipleRoles
      requestBody:
        content:
          application/json:
