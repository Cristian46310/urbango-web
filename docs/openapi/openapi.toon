components,
  schemas,
    PostRoleDTO,
      type,object
      properties,
        name,
          type,string
          minLength,1
        description,
          type,string
          minLength,1
      required[2],description,name
    GetRoleDTO,
      type,object
      properties,
        id,
          type,string
        name,
          type,string
        description,
          type,string
    PostUserDTO,
      type,object
      properties,
        name,
          type,string
          minLength,1
        email,
          type,string
          format,email
          minLength,1
        password,
          type,string
          minLength,1
          pattern,^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z\\d]).{8,}$
      required[3],email,name,password
    GetUserDTO,
      type,object
      properties,
        id,
          type,string
        name,
          type,string
        email,
          type,string
        roles,
          type,array
          items,
            $ref,#/components/schemas/UserRoleDTO
    UserRoleDTO,
      type,object
      properties,
        id,
          type,string
        userId,
          type,string
        roleId,
          type,string
    PostProfileDTO,
      type,object
      properties,
        phone,
          type,string
          maxLength,10
          minLength,10
          pattern,^[0-9]+$
        photo,
          type,string
          minLength,1
      required[2],phone,photo
    GetProfileDTO,
      type,object
      properties,
        id,
          type,string
        phone,
          type,string
        photo,
          type,string
        userId,
          type,string
    PostPermissionDTO,
      type,object
      properties,
        url,
          type,string
          minLength,1
          pattern,^/[^\\s]*$
        method,
          type,string
          enum[4],GET,POST,PUT,DELETE
      required[1],url
    GetPermissionDTO,
      type,object
      properties,
        id,
          type,string
        url,
          type,string
        method,
          type,string
          enum[4],GET,POST,PUT,DELETE
    ResponseMessage,
      type,object
      properties,
        message,
          type,string
    AssignRolesDTO,
      type,object
      properties,
        userId,
          type,string
          minLength,1
        roleIds,
          type,array
          items,
            type,string
          maxItems,2147483647
          minItems,1
      required[1],userId
    Verify2FADTO,
      type,object
      properties,
        challengeToken,
          type,string
          minLength,1
        code,
          type,string
          minLength,1
          pattern,^\\d+$
      required[2],challengeToken,code
    TokenDTO,
      type,object
      properties,
        token,
          type,string
    LoginDTO,
      type,object
      properties,
        email,
          type,string
          format,email
          minLength,1
        password,
          type,string
          minLength,1
          pattern,^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z\\d]).{8,}$
      required[2],email,password
    LoginChallengeDTO,
      type,object
      properties,
        challengeToken,
          type,string
        expiration,
          type,string
          format,date-time
        message,
          type,string
  securitySchemes,
    bearer-jwt,
      type,http
      description,JWT token obtenido del endpoint /auth/login
      scheme,bearer
      bearerFormat,JWT